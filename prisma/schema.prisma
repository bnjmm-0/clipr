// En dev : SQLite (fichier local). En production : passer provider à "postgresql"
// et DATABASE_URL vers Neon/Supabase (région UE). Les champs JSON sont stockés en texte
// pour rester compatibles avec les deux.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         String         @default("user") // "admin" = l'exploitant (le client) ; "user" = ses utilisateurs
  plan         String         @default("free")
  createdAt    DateTime       @default(now())
  sessions     Session[]
  projects     Project[]
  credits      CreditLedger[]
  usage        UsageEvent[]
  social       SocialAccount[]
  generations  Generation[]
  coachReports CoachReport[]
  characters   Character[]
  series       Series[]
  episodes     Episode[]
  snapshots    AccountSnapshot[]
  // Publication automatique : {"enabled":bool,"platforms":["tiktok","facebook"],"times":["09:00","18:00"],"clips":bool,"episodes":bool,"privacy":"SELF_ONLY"}
  autoPublishJson String @default("{\"enabled\":false,\"platforms\":[\"tiktok\"],\"times\":[\"12:00\",\"19:00\"],\"clips\":false,\"episodes\":true,\"privacy\":\"SELF_ONLY\"}")
}

// Personnage IA réutilisable (humain, animal, objet, mascotte, fruit… tout est possible).
model Character {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  look        String   // description visuelle, injectée dans chaque prompt d'image/vidéo
  personality String   @default("")
  voice       String   @default("alloy") // voix de synthèse (OpenAI TTS)
  visualStyle String   @default("cinématique réaliste")
  refImagePath String? // fiche de référence (vue de face, fond neutre) qui verrouille son apparence dans chaque image
  createdAt   DateTime @default(now())
  series      Series[]
}

// Série : un concept récurrent dont chaque épisode est généré puis enregistré automatiquement.
model Series {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  premise     String
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  durationSec Int       @default(60)
  language    String    @default("fr")
  captionStyle String   @default("bold")
  visualMode  String   @default("image")
  // IA choisies pour cette vidéo (vides = celles de Réglages) : voir lib/engines.ts.
  engineScript String?  // gpt | claude
  voice       String?   // voix OpenAI (ex. "coral") ou "elevenlabs:<id de voix>"
  engineImage String?   // gpt-image | flux
  engineVideo String?   // kling | veo | seedance
  castJson    String?   // ids des personnages qui jouent (dialogues entre personnages)
  format      String    @default("narration") // narration (voix off) | dialogue (chaque réplique avec la voix de son personnage)
  review      Boolean   @default(false) // s'arrêter après le script et les images pour validation
  optionsJson String?   // options de création (genre, accroche, fin, rythme, décor…) : lib/story-options.ts
  createdAt   DateTime  @default(now())
  episodes    Episode[]
}

// Vidéo IA complète : script → voix → visuels par scène → montage + sous-titres animés.
model Episode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  number      Int      @default(1)
  title       String
  brief       String   // consigne de départ (idée, tendance, vidéo reprise…)
  origin      String   @default("manual") // manual | series | trend | remix
  sourceUrl   String?  // vidéo reprise (mode « Reprendre »)
  durationSec Int      @default(60)
  captionStyle String  @default("bold")
  visualMode  String   @default("image") // image (images animées) | video (modèle vidéo Replicate)
  // IA choisies pour cette vidéo (vides = celles de Réglages) : voir lib/engines.ts.
  engineScript String?  // gpt | claude
  voice       String?   // voix OpenAI (ex. "coral") ou "elevenlabs:<id de voix>"
  engineImage String?   // gpt-image | flux
  engineVideo String?   // kling | veo | seedance
  castJson    String?   // ids des personnages qui jouent (dialogues entre personnages)
  format      String    @default("narration") // narration (voix off) | dialogue (chaque réplique avec la voix de son personnage)
  review      Boolean   @default(false) // s'arrêter après le script et les images pour validation
  optionsJson String?   // options de création (genre, accroche, fin, rythme, décor…) : lib/story-options.ts
  approved    Boolean   @default(false) // storyboard validé : voix et vidéo peuvent être générées
  language    String   @default("fr")
  characterId String?  // personnage utilisé hors série
  scriptJson  String?  // {title, hook, scenes:[{narration, visual}], summary}
  status      String   @default("queued") // queued | processing | ready | failed
  stage       String   @default("script")
  progress    Int      @default(0)
  filePath    String?
  thumbPath   String?
  coverPath   String?
  error       String?
  createdAt   DateTime @default(now())
  publications Publication[]
}

// Tendances relevées toutes les 6 h (vidéos qui montent + idées générées).
model TrendSnapshot {
  id        String   @id @default(cuid())
  region    String   @default("FR")
  videosJson String  // vidéos YouTube qui montent
  searchesJson String // recherches Google en hausse
  ideasJson String   @default("[]") // idées de vidéos proposées par le LLM
  error     String?
  createdAt DateTime @default(now())
}

// Statistiques des comptes connectés, relevées toutes les 6 h pour tracer l'évolution.
model AccountSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  followers  Int      @default(0)
  likes      Int      @default(0)
  videos     Int      @default(0)
  views      Int      @default(0)
  topJson    String   @default("[]")
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id // hash SHA-256 du jeton (le jeton brut n'est que dans le cookie)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Réglages de l'instance : une seule ligne (id = "global").
model AppSettings {
  id           String   @id @default("global")
  featuresJson String   @default("{\"clips\":true,\"textToImage\":false,\"textToVideo\":false,\"tiktokCoach\":false,\"tiktokPublish\":false}")
  llmProvider  String   @default("openai")       // openai | anthropic
  llmModel     String   @default("gpt-4o-mini")
  sttProvider  String   @default("openai")       // openai | groq
  imageProvider String  @default("openai")       // openai | replicate
  imageModel   String   @default("gpt-image-1")
  videoModel   String   @default("")             // slug Replicate, ex. "minimax/video-01"
  ttsModel     String   @default("gpt-4o-mini-tts") // voix off des vidéos IA (OpenAI)
  trendRegion  String   @default("FR")
  trendNiche   String   @default("")              // thème du client pour orienter les idées de tendances
  pricesJson   String   @default("{}")           // surcharges des tarifs pour le compteur
  freeMinutes  Int      @default(10)
  updatedAt    DateTime @updatedAt
}

// Clés API chiffrées (AES-256-GCM). La valeur en clair n'est jamais renvoyée au navigateur.
model ApiCredential {
  id         String   @id @default(cuid())
  name       String   @unique // openai | anthropic | groq | replicate | tiktok_client_key | tiktok_client_secret
  ciphertext String
  iv         String
  tag        String
  last4      String
  updatedAt  DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  status       String   @default("queued") // queued | processing | ready | failed
  stage        String   @default("import")
  progress     Int      @default(0)
  language     String   @default("fr")
  minClipSec   Int      @default(20)
  maxClipSec   Int      @default(60)
  clipCount    Int      @default(6)
  captionStyle String   @default("bold")
  cropMode     String   @default("center") // center | wide
  engineScript String?  // IA qui choisit les moments forts : gpt | claude (vide = Réglages)
  error        String?
  rightsAccepted Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  source       Source?
  clips        Clip[]
  jobs         Job[]
}

model Source {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String   // upload | url
  url         String?
  originalPath String?
  normalizedPath String?
  audioPath   String?
  durationSec Float?
  width       Int?
  height      Int?
  importState String   @default("pending")
  transcript  Transcript?
}

model Transcript {
  id        String  @id @default(cuid())
  sourceId  String  @unique
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  language  String?
  text      String
  wordsJson String  // [{w, s, e}]
  segmentsJson String
}

model Clip {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startSec   Float
  endSec     Float
  score      Int
  title      String
  reason     String?
  style      String
  cropOffset Float    @default(0.5) // 0 = gauche, 1 = droite (recadrage manuel)
  captionOverride String? // texte corrigé (JSON des mots)
  filePath   String?
  thumbPath  String?
  coverPath  String?  // miniature travaillée (meilleure image + titre)
  status     String   @default("pending") // pending | rendering | ready | failed | discarded
  createdAt  DateTime @default(now())
  publications Publication[]
}

model Job {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String    // pipeline | render_clip | generate | publish
  payload    String    @default("{}")
  stage      String?
  state      String    @default("queued") // queued | running | done | failed
  error      String?
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes   Float    // positif = ajout, négatif = consommation
  reason    String
  createdAt DateTime @default(now())
}

// Compteur d'usage : chaque appel API payant est enregistré avec un coût estimé.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider  String
  kind      String   // llm | transcription | image | video | tiktok | publication | quota
  model     String?
  units     Float    // tokens, minutes, images, secondes…
  unitLabel String
  costUsd   Float
  meta      String?
  createdAt DateTime @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String
  stripeCustomerId String?
  stripeSubId String?
  periodEnd DateTime?
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String   // tiktok | facebook | youtube
  openId       String   // TikTok : open_id ; Facebook : id de la Page ; YouTube : id de la chaîne
  displayName  String?
  avatarUrl    String?
  accessEnc    String   // jeton chiffré (JSON {c,iv,tag})
  refreshEnc   String?
  expiresAt    DateTime?
  scopes       String?
  createdAt    DateTime @default(now())
  @@unique([userId, platform])
}

model Publication {
  id          String   @id @default(cuid())
  userId      String?
  clipId      String?
  clip        Clip?    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  episodeId   String?
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  platform    String   // tiktok | facebook | youtube
  caption     String?
  privacy     String   @default("SELF_ONLY")
  auto        Boolean  @default(false) // créée par la publication automatique
  scheduledAt DateTime?
  state       String   @default("scheduled") // scheduled | sending | sent | failed
  externalId  String?
  error       String?
  createdAt   DateTime @default(now())
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // image | video
  prompt    String
  status    String   @default("queued")
  filePath  String?
  remoteUrl String?
  error     String?
  createdAt DateTime @default(now())
}

model CoachReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  input     String
  output    String
  createdAt DateTime @default(now())
}
