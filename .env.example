# Base de données (dev : SQLite ; prod : URL PostgreSQL et provider "postgresql" dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Clé maître de chiffrement des clés API (32 octets en base64). Générer : npm run gen:key
# À garder secrète, hors du dépôt. Si elle est perdue, les clés API devront être ressaisies.
ENCRYPTION_KEY=""
# URL publique de l'appli (sert au retour OAuth TikTok, Facebook et YouTube)
APP_URL="http://localhost:3000"
# Dossier de stockage des vidéos
STORAGE_DIR="./storage"
# Quota quotidien YouTube Data API du projet Google (10 000 par défaut, à relever si Google l'augmente)
YOUTUBE_DAILY_QUOTA=10000
